import { LineEdit } from "std-widgets.slint";
import { GlassSurface, Hairline, IconButton, ActionButton, ToggleRow, FieldLabel, GlassSlider } from "primitives.slint";

export component SettingsWindow inherits Window {
    in-out property <bool> start-on-boot;
    in-out property <bool> show-main;
    in-out property <bool> show-top;
    in-out property <bool> main-pinned;
    in-out property <bool> top-pinned;
    in-out property <bool> main-locked;
    in-out property <bool> top-locked;
    in-out property <bool> oled-shift;
    in-out property <float> panel-opacity;
    in-out property <string> refresh-seconds;
    in-out property <string> codex-command;
    in-out property <string> provider;
    in-out property <bool> update-on-start;
    in-out property <string> update-endpoint;
    in property <string> version-text;
    in property <string> update-status-text: "尚未检查更新";
    callback close-window;
    callback start-drag;
    callback save-settings;
    callback check-update;
    callback install-update;
    callback open-detail;
    callback refresh;
    callback quit-app;

    width: 700px;
    height: 520px;
    no-frame: true;
    background: transparent;
    title: "Codex Gauge 设置";

    GlassSurface {
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        x: 9px;
        y: 5px;
        width: parent.width - 64px;
        height: 51px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-drag();
            }
        }
    }

    Text {
        x: 24px;
        y: 14px;
        text: "设置";
        color: #f7fbfd;
        font-family: "Segoe UI Variable Display";
        font-size: 22px;
        font-weight: 760;
    }

    Text {
        x: 77px;
        y: 24px;
        text: root.version-text;
        color: #8297a6;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 650;
    }

    IconButton {
        x: parent.width - 46px;
        y: 13px;
        width: 30px;
        height: 30px;
        label: "×";
        clicked => { root.close-window(); }
    }

    Hairline {
        x: 16px;
        y: 60px;
        width: parent.width - 32px;
    }

    Rectangle {
        x: 20px;
        y: 76px;
        width: 320px;
        height: 368px;
        border-radius: 12px;
        background: #ffffff07;
        border-width: 1px;
        border-color: #ffffff17;

        Text {
            x: 16px;
            y: 12px;
            text: "窗口";
            color: #b8c7d1;
            font-family: "Segoe UI Variable Text";
            font-size: 12px;
            font-weight: 700;
        }

        VerticalLayout {
            x: 16px;
            y: 37px;
            width: parent.width - 32px;
            height: 238px;
            spacing: 0px;

            ToggleRow { label: "启动时显示桌面浮窗"; checked <=> root.show-main; }
            ToggleRow { label: "启动时显示顶部浮窗"; checked <=> root.show-top; }
            ToggleRow { label: "桌面浮窗置顶"; checked <=> root.main-pinned; }
            ToggleRow { label: "顶部浮窗置顶"; checked <=> root.top-pinned; }
            ToggleRow { label: "锁定桌面浮窗位置"; checked <=> root.main-locked; }
            ToggleRow { label: "锁定顶部浮窗位置"; checked <=> root.top-locked; }
            ToggleRow { label: "防 OLED 烧屏微位移"; checked <=> root.oled-shift; }
            ToggleRow { label: "开机启动"; checked <=> root.start-on-boot; }
        }

        FieldLabel {
            x: 16px;
            y: 286px;
            text: "浮窗透明度";
        }

        GlassSlider {
            x: 16px;
            y: 298px;
            width: parent.width - 32px;
            minimum: 68;
            maximum: 100;
            value <=> root.panel-opacity;
        }

        ActionButton {
            x: 16px;
            y: 335px;
            width: 138px;
            height: 25px;
            label: root.show-main ? "隐藏桌面浮窗" : "显示桌面浮窗";
            clicked => { root.show-main = !root.show-main; }
        }

        ActionButton {
            x: parent.width - 154px;
            y: 335px;
            width: 138px;
            height: 25px;
            label: root.show-top ? "隐藏顶部浮窗" : "显示顶部浮窗";
            clicked => { root.show-top = !root.show-top; }
        }
    }

    Rectangle {
        x: 358px;
        y: 76px;
        width: 322px;
        height: 368px;
        border-radius: 12px;
        background: #ffffff07;
        border-width: 1px;
        border-color: #ffffff17;

        Text {
            x: 16px;
            y: 12px;
            text: "数据与更新";
            color: #b8c7d1;
            font-family: "Segoe UI Variable Text";
            font-size: 12px;
            font-weight: 700;
        }

        FieldLabel { x: 16px; y: 41px; text: "CODEX 命令"; }
        LineEdit {
            x: 16px;
            y: 57px;
            width: parent.width - 32px;
            text <=> root.codex-command;
        }

        FieldLabel { x: 16px; y: 96px; text: "优先查询方式"; }

        Rectangle {
            x: 16px;
            y: 113px;
            width: parent.width - 32px;
            height: 29px;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff22;
            background: #080d131f;

            Rectangle {
                x: 3px;
                y: 3px;
                width: (parent.width - 6px) / 2;
                height: parent.height - 6px;
                border-radius: 6px;
                background: root.provider == "app-server" ? #5bddc92e : transparent;
                Text {
                    text: "app-server 优先";
                    color: root.provider == "app-server" ? #baffef : #92a4b1;
                    font-family: "Segoe UI Variable Text";
                    font-size: 10px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.provider = "app-server"; }
                }
            }

            Rectangle {
                x: (parent.width - 6px) / 2 + 3px;
                y: 3px;
                width: (parent.width - 6px) / 2;
                height: parent.height - 6px;
                border-radius: 6px;
                background: root.provider == "api" ? #5bddc92e : transparent;
                Text {
                    text: "API 优先";
                    color: root.provider == "api" ? #baffef : #92a4b1;
                    font-family: "Segoe UI Variable Text";
                    font-size: 10px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.provider = "api"; }
                }
            }
        }

        FieldLabel { x: 16px; y: 153px; text: "刷新间隔（秒）"; }
        LineEdit {
            x: 16px;
            y: 169px;
            width: 102px;
            text <=> root.refresh-seconds;
        }

        ToggleRow {
            x: 136px;
            y: 165px;
            width: parent.width - 152px;
            label: "启动检查更新";
            checked <=> root.update-on-start;
        }

        FieldLabel { x: 16px; y: 207px; text: "更新地址"; }
        LineEdit {
            x: 16px;
            y: 223px;
            width: parent.width - 32px;
            text <=> root.update-endpoint;
        }

        Rectangle {
            x: 16px;
            y: 262px;
            width: parent.width - 32px;
            height: 49px;
            background: transparent;

            Rectangle {
                x: 0px;
                y: 8px;
                width: 2px;
                height: parent.height - 16px;
                border-radius: 1px;
                background: #67ddc7;
            }

            Text {
                x: 10px;
                y: 7px;
                width: parent.width - 20px;
                height: parent.height - 14px;
                text: root.update-status-text;
                color: #b7c7d1;
                font-family: "Segoe UI Variable Text";
                font-size: 10px;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        ActionButton {
            x: 16px;
            y: 326px;
            width: 92px;
            height: 25px;
            label: "检查更新";
            clicked => { root.check-update(); }
        }

        ActionButton {
            x: 116px;
            y: 326px;
            width: 92px;
            height: 25px;
            label: "安装更新";
            primary: true;
            clicked => { root.install-update(); }
        }

        ActionButton {
            x: 216px;
            y: 326px;
            width: parent.width - 232px;
            height: 25px;
            label: "刷新用量";
            clicked => { root.refresh(); }
        }
    }

    Hairline {
        x: 16px;
        y: 456px;
        width: parent.width - 32px;
    }

    ActionButton {
        x: 20px;
        y: 471px;
        width: 104px;
        height: 31px;
        label: "退出应用";
        danger: true;
        clicked => { root.quit-app(); }
    }

    ActionButton {
        x: parent.width - 252px;
        y: 471px;
        width: 100px;
        height: 31px;
        label: "打开详情";
        clicked => { root.open-detail(); }
    }

    ActionButton {
        x: parent.width - 142px;
        y: 471px;
        width: 122px;
        height: 31px;
        label: "保存设置";
        primary: true;
        clicked => { root.save-settings(); }
    }
}
