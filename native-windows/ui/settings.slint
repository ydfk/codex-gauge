import { LineEdit } from "std-widgets.slint";
import { AppLogo, WindowSurface, Hairline, IconButton, ActionButton, ToggleRow, FieldLabel, GlassSlider } from "primitives.slint";

export component SettingsWindow inherits Window {
    in-out property <bool> start-on-boot;
    in-out property <bool> show-top;
    in-out property <bool> top-pinned;
    in-out property <bool> top-locked;
    in-out property <bool> oled-shift;
    in-out property <float> panel-opacity;
    in-out property <string> refresh-seconds;
    in-out property <string> codex-command;
    in-out property <string> provider;
    in-out property <bool> update-on-start;
    in-out property <string> update-endpoint;
    in property <string> version-text;
    in property <string> update-status-text: "尚未检查更新";
    callback close-window;
    callback start-drag;
    callback save-settings;
    callback check-update;
    callback install-update;
    callback open-detail;
    callback refresh;
    callback quit-app;

    width: 620px;
    height: 500px;
    no-frame: true;
    background: transparent;
    title: "Codex Gauge 设置";

    WindowSurface { width: parent.width; height: parent.height; }

    TouchArea {
        x: 10px;
        y: 5px;
        width: parent.width - 64px;
        height: 54px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-drag();
            }
        }
    }

    AppLogo { x: 20px; y: 14px; width: 32px; height: 32px; }

    Text {
        x: 64px;
        y: 12px;
        text: "设置";
        color: #f1f4f7;
        font-family: "Segoe UI Variable Display";
        font-size: 18px;
        font-weight: 740;
    }

    Text {
        x: 64px;
        y: 36px;
        text: "Codex Gauge " + root.version-text;
        color: #7f8e9c;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 600;
    }

    IconButton {
        x: parent.width - 44px;
        y: 14px;
        label: "×";
        clicked => { root.close-window(); }
    }

    Hairline { x: 18px; y: 62px; width: parent.width - 36px; }

    Text {
        x: 24px;
        y: 82px;
        text: "顶部状态条";
        color: #9aa8b5;
        font-family: "Segoe UI Variable Text";
        font-size: 11px;
        font-weight: 720;
    }

    Text {
        x: 24px;
        y: 100px;
        text: "控制唯一常驻桌面的界面";
        color: #687785;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
    }

    VerticalLayout {
        x: 24px;
        y: 124px;
        width: 256px;
        spacing: 0px;

        ToggleRow { label: "启动时显示"; checked <=> root.show-top; }
        ToggleRow { label: "始终置顶"; checked <=> root.top-pinned; }
        ToggleRow { label: "锁定横向位置"; checked <=> root.top-locked; }
        ToggleRow { label: "防 OLED 烧屏微位移"; checked <=> root.oled-shift; }
        ToggleRow { label: "开机启动"; checked <=> root.start-on-boot; }
    }

    FieldLabel { x: 24px; y: 306px; text: "透明度"; }
    GlassSlider {
        x: 24px;
        y: 320px;
        width: 256px;
        minimum: 68;
        maximum: 100;
        value <=> root.panel-opacity;
    }

    ActionButton {
        x: 24px;
        y: 365px;
        width: 256px;
        height: 32px;
        label: root.show-top ? "隐藏顶部状态条" : "显示顶部状态条";
        clicked => { root.show-top = !root.show-top; }
    }

    Rectangle {
        x: 302px;
        y: 82px;
        width: 1px;
        height: 315px;
        background: #ffffff14;
    }

    Text {
        x: 326px;
        y: 82px;
        text: "数据与更新";
        color: #9aa8b5;
        font-family: "Segoe UI Variable Text";
        font-size: 11px;
        font-weight: 720;
    }

    FieldLabel { x: 326px; y: 112px; text: "CODEX 命令"; }
    LineEdit {
        x: 326px;
        y: 127px;
        width: 270px;
        height: 32px;
        text <=> root.codex-command;
    }

    FieldLabel { x: 326px; y: 171px; text: "优先查询方式"; }
    Rectangle {
        x: 326px;
        y: 186px;
        width: 270px;
        height: 31px;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff20;
        background: #090d131f;

        Rectangle {
            x: 3px;
            y: 3px;
            width: (parent.width - 6px) / 2;
            height: parent.height - 6px;
            border-radius: 6px;
            background: root.provider == "app-server" ? #6579df43 : transparent;
            Text {
                text: "App Server";
                color: root.provider == "app-server" ? #e5e9ff : #7f8d9a;
                font-family: "Segoe UI Variable Text";
                font-size: 10px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.provider = "app-server"; } }
        }

        Rectangle {
            x: (parent.width - 6px) / 2 + 3px;
            y: 3px;
            width: (parent.width - 6px) / 2;
            height: parent.height - 6px;
            border-radius: 6px;
            background: root.provider == "api" ? #6579df43 : transparent;
            Text {
                text: "AuthJson API";
                color: root.provider == "api" ? #e5e9ff : #7f8d9a;
                font-family: "Segoe UI Variable Text";
                font-size: 10px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.provider = "api"; } }
        }
    }

    FieldLabel { x: 326px; y: 230px; text: "刷新间隔（秒）"; }
    LineEdit {
        x: 326px;
        y: 245px;
        width: 96px;
        height: 32px;
        text <=> root.refresh-seconds;
    }

    ToggleRow {
        x: 442px;
        y: 239px;
        width: 154px;
        label: "启动检查更新";
        checked <=> root.update-on-start;
    }

    FieldLabel { x: 326px; y: 289px; text: "更新地址"; }
    LineEdit {
        x: 326px;
        y: 304px;
        width: 270px;
        height: 32px;
        text <=> root.update-endpoint;
    }

    Rectangle {
        x: 326px;
        y: 348px;
        width: 270px;
        height: 35px;
        background: transparent;

        Rectangle { width: 2px; height: parent.height; border-radius: 1px; background: #8195ff; }
        Text {
            x: 10px;
            width: parent.width - 10px;
            height: parent.height;
            text: root.update-status-text;
            color: #8e9ba8;
            font-family: "Segoe UI Variable Text";
            font-size: 9px;
            font-weight: 600;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    ActionButton {
        x: 326px;
        y: 395px;
        width: 84px;
        label: "检查更新";
        clicked => { root.check-update(); }
    }
    ActionButton {
        x: 418px;
        y: 395px;
        width: 86px;
        label: "安装更新";
        primary: true;
        clicked => { root.install-update(); }
    }
    ActionButton {
        x: 512px;
        y: 395px;
        width: 84px;
        label: "刷新用量";
        clicked => { root.refresh(); }
    }

    Hairline { x: 18px; y: 443px; width: parent.width - 36px; }

    ActionButton {
        x: 20px;
        y: 456px;
        width: 90px;
        height: 28px;
        label: "退出应用";
        danger: true;
        clicked => { root.quit-app(); }
    }
    ActionButton {
        x: parent.width - 204px;
        y: 456px;
        width: 84px;
        height: 28px;
        label: "打开详情";
        clicked => { root.open-detail(); }
    }
    ActionButton {
        x: parent.width - 112px;
        y: 456px;
        width: 92px;
        height: 28px;
        label: "保存设置";
        primary: true;
        clicked => { root.save-settings(); }
    }
}
