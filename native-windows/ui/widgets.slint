import { GaugeData, MenuBarLogo, TopSurface } from "primitives.slint";

component TopMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> remaining;

    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: 19px;
        height: parent.height;
        text: root.label;
        color: #8f9ba7;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.value == "未知" ? "--" : root.value;
        color: root.value == "未知" ? #7f8a95
            : root.remaining >= 70 ? #79e5cf
            : root.remaining >= 30 ? #77b8ff
            : root.remaining >= 15 ? #f0c96e
            : root.remaining >= 5 ? #ff9a72
            : #ff6f82;
        font-family: "Segoe UI Variable Text";
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component TopWidget inherits Window {
    in property <GaugeData> data;
    in property <string> display-mode: "five-hour";
    in property <float> panel-opacity: 0.96;
    in property <bool> pinned: true;
    in property <bool> locked: false;
    property <bool> show-five: root.display-mode != "icon-only" && root.data.five-visible;
    property <bool> show-seven: root.display-mode == "five-and-seven"
        || (root.display-mode != "icon-only" && !root.data.five-visible);
    property <length> press-x: 0px;
    property <bool> left-pressed: false;
    property <bool> dragging: false;
    callback refresh;
    callback toggle-panel;
    callback hide-window;
    callback start-drag;
    callback toggle-pin;
    callback toggle-lock;

    width: root.show-five && root.show-seven ? 158px
        : root.show-five || root.show-seven ? 92px
        : 34px;
    height: 22px;
    no-frame: true;
    background: transparent;
    always-on-top: root.pinned;
    title: "Codex Gauge";

    TopSurface {
        x: 0px;
        y: -4px;
        width: parent.width;
        height: parent.height + 4px;
        surface-opacity: root.panel-opacity;
    }

    MenuBarLogo {
        x: 8px;
        y: 5px;
        width: 12px;
        height: 12px;
    }

    if root.show-five || root.show-seven: Rectangle {
        x: 29px;
        y: 5px;
        width: 1px;
        height: 12px;
        background: #ffffff20;
    }

    if root.show-five: TopMetric {
        x: 36px;
        y: 0px;
        width: 55px;
        height: 22px;
        label: "5h";
        value: root.data.five-remaining-text;
        remaining: root.data.five-remaining;
    }

    if root.show-seven: TopMetric {
        x: root.show-five ? 96px : 36px;
        y: 0px;
        width: 55px;
        height: 22px;
        label: "7d";
        value: root.data.seven-remaining-text;
        remaining: root.data.seven-remaining;
    }

    ContextMenuArea {
        width: parent.width;
        height: parent.height;

        drag := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.locked ? default : ew-resize;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.press-x = drag.mouse-x;
                    root.left-pressed = true;
                    root.dragging = false;
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    if root.left-pressed && !root.dragging {
                        root.toggle-panel();
                    }
                    root.left-pressed = false;
                    root.dragging = false;
                }
            }
            moved => {
                if drag.pressed && root.left-pressed && !root.locked
                    && (drag.mouse-x - root.press-x > 4px || drag.mouse-x - root.press-x < -4px) {
                    root.dragging = true;
                    root.left-pressed = false;
                    root.start-drag();
                }
            }
        }

        Menu {
            MenuItem { title: "刷新用量"; activated => { root.refresh(); } }
            MenuSeparator {}
            MenuItem { title: "始终置顶"; checkable: true; checked: root.pinned; activated => { root.toggle-pin(); } }
            MenuItem { title: "锁定位置"; checkable: true; checked: root.locked; activated => { root.toggle-lock(); } }
            MenuSeparator {}
            MenuItem { title: "关闭顶部状态条"; activated => { root.hide-window(); } }
        }
    }
}
