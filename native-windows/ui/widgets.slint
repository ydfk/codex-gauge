import { GaugeData, GlassSurface, ActionButton, Hairline, UsageRow } from "primitives.slint";

export component MainWidget inherits Window {
    in property <GaugeData> data;
    in property <float> panel-opacity: 0.94;
    in property <bool> pinned: false;
    in property <bool> locked: false;
    callback refresh;
    callback toggle-detail;
    callback open-settings;
    callback hide-window;
    callback start-drag;
    callback toggle-pin;
    callback toggle-lock;

    width: 430px;
    height: 104px;
    no-frame: true;
    background: transparent;
    always-on-top: root.pinned;
    title: "Codex Gauge";

    GlassSurface {
        width: parent.width;
        height: parent.height;
        surface-opacity: root.panel-opacity;
    }

    drag := TouchArea {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 34px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-drag();
            }
        }
        double-clicked => { root.toggle-detail(); }
    }

    Text {
        x: 17px;
        y: 7px;
        text: "Codex";
        color: #f7fbfd;
        font-family: "Segoe UI Variable Display";
        font-size: 19px;
        font-weight: 760;
    }

    Text {
        x: 78px;
        y: 13px;
        width: 183px;
        text: root.data.five-used-text + " · " + root.data.seven-used-text;
        color: #b8c7d1;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 600;
        overflow: elide;
    }

    ActionButton {
        x: parent.width - 127px;
        y: 6px;
        width: 70px;
        height: 26px;
        label: root.data.reset-count-text;
        primary: true;
        clicked => { root.toggle-detail(); }
    }

    ActionButton {
        x: parent.width - 52px;
        y: 6px;
        width: 40px;
        height: 26px;
        label: "详情";
        clicked => { root.toggle-detail(); }
    }

    Hairline {
        x: 12px;
        y: 37px;
        width: parent.width - 24px;
    }

    VerticalLayout {
        x: 17px;
        y: 40px;
        width: parent.width - 34px;
        spacing: 0px;

        UsageRow {
            label: "5h";
            remaining-text: root.data.five-remaining-text;
            reset-text: root.data.five-reset-text;
            remaining: root.data.five-remaining;
            accent: root.data.five-remaining >= 70 ? #80efd4
                : root.data.five-remaining >= 50 ? #61d9e8
                : root.data.five-remaining >= 30 ? #7caeff
                : root.data.five-remaining >= 15 ? #f3c867
                : root.data.five-remaining >= 5 ? #ff9169
                : #ff6378;
        }

        UsageRow {
            label: "7d";
            remaining-text: root.data.seven-remaining-text;
            reset-text: root.data.seven-reset-text;
            remaining: root.data.seven-remaining;
            accent: root.data.seven-remaining >= 70 ? #80efd4
                : root.data.seven-remaining >= 50 ? #61d9e8
                : root.data.seven-remaining >= 30 ? #7caeff
                : root.data.seven-remaining >= 15 ? #f3c867
                : root.data.seven-remaining >= 5 ? #ff9169
                : #ff6378;
        }
    }

    ContextMenuArea {
        width: parent.width;
        height: parent.height;

        Menu {
            MenuItem { title: "刷新用量"; activated => { root.refresh(); } }
            MenuSeparator {}
            MenuItem { title: root.pinned ? "取消桌面浮窗置顶" : "桌面浮窗置顶"; activated => { root.toggle-pin(); } }
            MenuItem { title: root.locked ? "解锁桌面浮窗位置" : "锁定桌面浮窗位置"; activated => { root.toggle-lock(); } }
            MenuSeparator {}
            MenuItem { title: "打开设置"; activated => { root.open-settings(); } }
            MenuItem { title: "隐藏桌面浮窗"; activated => { root.hide-window(); } }
        }
    }
}

export component TopWidget inherits Window {
    in property <GaugeData> data;
    in property <float> panel-opacity: 0.94;
    in property <bool> pinned: true;
    in property <bool> locked: false;
    in property <bool> expanded: false;
    callback refresh;
    callback open-detail;
    callback hide-window;
    callback start-drag;
    callback toggle-pin;
    callback toggle-lock;

    width: root.data.five-visible ? 220px : 170px;
    height: root.expanded ? 94px : 28px;
    no-frame: true;
    background: transparent;
    always-on-top: root.pinned;
    title: "Codex Gauge Status";

    GlassSurface {
        width: parent.width;
        height: parent.height;
        surface-opacity: root.panel-opacity;
    }

    HorizontalLayout {
        x: 11px;
        y: 0px;
        width: parent.width - 22px;
        height: 28px;
        spacing: 9px;

        if root.data.five-visible: Text {
            text: "5h " + root.data.five-remaining-text;
            color: root.data.five-remaining >= 70 ? #80efd4
                : root.data.five-remaining >= 50 ? #61d9e8
                : root.data.five-remaining >= 30 ? #7caeff
                : root.data.five-remaining >= 15 ? #f3c867
                : root.data.five-remaining >= 5 ? #ff9169
                : #ff6378;
            font-family: "Segoe UI Variable Text";
            font-size: 12px;
            font-weight: 720;
            vertical-alignment: center;
        }

        Text {
            text: "7d " + root.data.seven-remaining-text;
            color: root.data.seven-remaining >= 70 ? #80efd4
                : root.data.seven-remaining >= 50 ? #61d9e8
                : root.data.seven-remaining >= 30 ? #7caeff
                : root.data.seven-remaining >= 15 ? #f3c867
                : root.data.seven-remaining >= 5 ? #ff9169
                : #ff6378;
            font-family: "Segoe UI Variable Text";
            font-size: 12px;
            font-weight: 720;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px;
            height: 28px;
            background: transparent;

            Rectangle {
                y: 8px;
                width: 1px;
                height: 12px;
                background: #ffffff27;
            }
        }

        Text {
            text: root.data.reset-count-text;
            color: #dce6ec;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 620;
            vertical-alignment: center;
        }
    }

    if root.expanded: Rectangle {
        x: 10px;
        y: 33px;
        width: parent.width - 20px;
        height: 51px;
        background: transparent;

        Hairline {
            x: 0px;
            y: 0px;
            width: parent.width;
        }

        if root.data.five-visible: Text {
            x: 2px;
            y: 7px;
            text: "5h  剩余 " + root.data.five-remaining-text + "  ·  " + root.data.five-used-text;
            color: #d9e5ec;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            x: 2px;
            y: root.data.five-visible ? 24px : 8px;
            text: "7d  剩余 " + root.data.seven-remaining-text + "  ·  " + root.data.seven-used-text;
            color: #d9e5ec;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            x: 2px;
            y: root.data.five-visible ? 41px : 29px;
            text: root.data.reset-count-text;
            color: #8fa5b4;
            font-family: "Segoe UI Variable Text";
            font-size: 10px;
            font-weight: 600;
        }
    }

    ContextMenuArea {
        width: parent.width;
        height: parent.height;

        drag := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: move;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.start-drag();
                }
            }
            double-clicked => { root.open-detail(); }
        }

        Menu {
            MenuItem { title: "刷新用量"; activated => { root.refresh(); } }
            MenuSeparator {}
            MenuItem { title: root.pinned ? "取消顶部浮窗置顶" : "顶部浮窗置顶"; activated => { root.toggle-pin(); } }
            MenuItem { title: root.locked ? "解锁顶部浮窗位置" : "锁定顶部浮窗位置"; activated => { root.toggle-lock(); } }
            MenuSeparator {}
            MenuItem { title: "隐藏顶部浮窗"; activated => { root.hide-window(); } }
        }
    }
}
