import { GaugeData, AppLogo, WindowSurface, Hairline, IconButton, MeterBar, MetricCell, ActionButton } from "primitives.slint";

component UsagePanel inherits Rectangle {
    in property <string> title;
    in property <string> remaining-text;
    in property <string> used-text;
    in property <string> reset-text;
    in property <float> remaining;
    in property <color> accent;

    background: #ffffff06;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff16;

    Rectangle {
        x: 0px;
        y: 18px;
        width: 2px;
        height: parent.height - 36px;
        border-radius: 1px;
        background: root.accent;
    }

    Text {
        x: 16px;
        y: 14px;
        text: root.title;
        color: #8997a5;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 700;
    }

    Text {
        x: 16px;
        y: 34px;
        width: parent.width - 32px;
        text: root.remaining-text;
        color: root.accent;
        font-family: "Segoe UI Variable Display";
        font-size: 28px;
        font-weight: 760;
    }

    MeterBar {
        x: 16px;
        y: 76px;
        width: parent.width - 32px;
        value: root.remaining;
        accent: root.accent;
    }

    Text {
        x: 16px;
        y: 91px;
        width: parent.width - 32px;
        text: root.used-text;
        color: #a8b3bd;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 600;
    }

    Text {
        x: 16px;
        y: 108px;
        width: parent.width - 32px;
        text: "重置 " + root.reset-text;
        color: #748392;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 600;
        overflow: elide;
    }
}

export component DetailWindow inherits Window {
    in property <GaugeData> data;
    in property <string> version-text;
    callback close-window;
    callback start-drag;
    callback refresh;

    width: 440px;
    height: 486px;
    no-frame: true;
    background: transparent;
    title: "Codex Gauge 详细信息";

    WindowSurface { width: parent.width; height: parent.height; }

    TouchArea {
        x: 10px;
        y: 5px;
        width: parent.width - 64px;
        height: 54px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-drag();
            }
        }
    }

    AppLogo { x: 20px; y: 14px; width: 32px; height: 32px; }

    Text {
        x: 64px;
        y: 12px;
        text: "Codex Gauge";
        color: #f1f4f7;
        font-family: "Segoe UI Variable Display";
        font-size: 18px;
        font-weight: 740;
    }

    Text {
        x: 64px;
        y: 36px;
        width: parent.width - 120px;
        text: root.data.status-text + "  ·  " + root.data.updated-text;
        color: #7f8e9c;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 600;
        overflow: elide;
    }

    IconButton {
        x: parent.width - 44px;
        y: 14px;
        label: "×";
        clicked => { root.close-window(); }
    }

    Hairline { x: 18px; y: 62px; width: parent.width - 36px; }

    UsagePanel {
        x: 20px;
        y: 80px;
        width: 194px;
        height: 136px;
        title: root.data.five-visible ? "5 小时剩余" : "5 小时";
        remaining-text: root.data.five-remaining-text;
        used-text: root.data.five-used-text;
        reset-text: root.data.five-reset-text;
        remaining: root.data.five-remaining;
        accent: root.data.five-remaining >= 70 ? #7ce5ca
            : root.data.five-remaining >= 50 ? #69d4e5
            : root.data.five-remaining >= 30 ? #7da8ff
            : root.data.five-remaining >= 15 ? #efc463
            : root.data.five-remaining >= 5 ? #ff946b
            : #ff6578;
    }

    UsagePanel {
        x: 226px;
        y: 80px;
        width: 194px;
        height: 136px;
        title: "7 天剩余";
        remaining-text: root.data.seven-remaining-text;
        used-text: root.data.seven-used-text;
        reset-text: root.data.seven-reset-text;
        remaining: root.data.seven-remaining;
        accent: root.data.seven-remaining >= 70 ? #7ce5ca
            : root.data.seven-remaining >= 50 ? #69d4e5
            : root.data.seven-remaining >= 30 ? #7da8ff
            : root.data.seven-remaining >= 15 ? #efc463
            : root.data.seven-remaining >= 5 ? #ff946b
            : #ff6578;
    }

    Text {
        x: 20px;
        y: 236px;
        text: "账户与额度";
        color: #8998a6;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 700;
    }

    GridLayout {
        x: 20px;
        y: 254px;
        width: parent.width - 40px;
        height: 148px;
        spacing: 0px;

        Row {
            MetricCell { label: "可用重置"; value: root.data.reset-count-text; value-color: #9eabff; }
            MetricCell { label: "当前计划"; value: root.data.plan-text; }
        }
        Row {
            MetricCell { label: "重置额度"; value: root.data.credit-detail-text; }
            MetricCell { label: "额度到期"; value: root.data.credit-expiry-text; }
        }
        Row {
            MetricCell { label: "数据来源"; value: root.data.source-text; }
            MetricCell { label: "客户端版本"; value: root.version-text; }
        }
    }

    ActionButton {
        x: 20px;
        y: 428px;
        width: parent.width - 40px;
        height: 36px;
        label: "刷新用量";
        primary: true;
        clicked => { root.refresh(); }
    }
}
