import { GaugeData, GlassSurface, Hairline, IconButton, MetricCell, ActionButton } from "primitives.slint";

export component DetailWindow inherits Window {
    in property <GaugeData> data;
    in property <string> version-text;
    callback close-window;
    callback start-drag;
    callback refresh;

    width: 460px;
    height: 520px;
    no-frame: true;
    background: transparent;
    title: "Codex Gauge 详细信息";

    GlassSurface {
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        x: 9px;
        y: 5px;
        width: parent.width - 64px;
        height: 53px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-drag();
            }
        }
        double-clicked => { root.close-window(); }
    }

    Text {
        x: 24px;
        y: 15px;
        text: "Codex Gauge";
        color: #f7fbfd;
        font-family: "Segoe UI Variable Display";
        font-size: 22px;
        font-weight: 760;
    }

    Text {
        x: 25px;
        y: 44px;
        text: root.data.status-text + "  ·  " + root.data.updated-text;
        color: #8fa3b2;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 600;
    }

    IconButton {
        x: parent.width - 46px;
        y: 14px;
        width: 30px;
        height: 30px;
        label: "×";
        clicked => { root.close-window(); }
    }

    Hairline {
        x: 16px;
        y: 70px;
        width: parent.width - 32px;
    }

    Rectangle {
        x: 24px;
        y: 88px;
        width: parent.width - 48px;
        height: 136px;
        background: #ffffff07;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff18;

        Text {
            x: 18px;
            y: 14px;
            text: root.data.five-visible ? "5 小时" : "5 小时 · 不限量";
            color: #91a5b3;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 650;
        }

        Text {
            x: 18px;
            y: 35px;
            text: root.data.five-remaining-text;
            color: root.data.five-remaining >= 30 ? #80efd4 : root.data.five-remaining >= 15 ? #f3c867 : #ff6378;
            font-family: "Segoe UI Variable Display";
            font-size: 29px;
            font-weight: 760;
        }

        Text {
            x: 18px;
            y: 80px;
            text: root.data.five-used-text;
            color: #c0ced7;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            x: 18px;
            y: 102px;
            text: "重置 " + root.data.five-reset-text;
            color: #8498a6;
            font-family: "Segoe UI Variable Text";
            font-size: 10px;
            font-weight: 600;
        }

        Rectangle {
            x: parent.width / 2;
            y: 16px;
            width: 1px;
            height: parent.height - 32px;
            background: #ffffff1a;
        }

        Text {
            x: parent.width / 2 + 20px;
            y: 14px;
            text: "7 天";
            color: #91a5b3;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 650;
        }

        Text {
            x: parent.width / 2 + 20px;
            y: 35px;
            text: root.data.seven-remaining-text;
            color: root.data.seven-remaining >= 30 ? #73cfff : root.data.seven-remaining >= 15 ? #f3c867 : #ff6378;
            font-family: "Segoe UI Variable Display";
            font-size: 29px;
            font-weight: 760;
        }

        Text {
            x: parent.width / 2 + 20px;
            y: 80px;
            text: root.data.seven-used-text;
            color: #c0ced7;
            font-family: "Segoe UI Variable Text";
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            x: parent.width / 2 + 20px;
            y: 102px;
            text: "重置 " + root.data.seven-reset-text;
            color: #8498a6;
            font-family: "Segoe UI Variable Text";
            font-size: 10px;
            font-weight: 600;
        }
    }

    GridLayout {
        x: 24px;
        y: 242px;
        width: parent.width - 48px;
        height: 200px;
        spacing: 0px;

        Row {
            MetricCell { label: "可用重置次数"; value: root.data.reset-count-text; value-color: #a8f4e2; }
            MetricCell { label: "计划"; value: root.data.plan-text; }
        }
        Row {
            MetricCell { label: "重置额度"; value: root.data.credit-detail-text; }
            MetricCell { label: "额度到期"; value: root.data.credit-expiry-text; }
        }
        Row {
            MetricCell { label: "数据来源"; value: root.data.source-text; }
            MetricCell { label: "当前状态"; value: root.data.status-text; }
        }
        Row {
            MetricCell { label: "客户端版本"; value: root.version-text; }
            MetricCell { label: "最后更新"; value: root.data.updated-text; }
        }
    }

    ActionButton {
        x: 24px;
        y: 463px;
        width: parent.width - 48px;
        height: 34px;
        label: "刷新用量";
        primary: true;
        clicked => { root.refresh(); }
    }
}
