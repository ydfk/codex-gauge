export struct GaugeData {
    status-text: string,
    plan-text: string,
    source-text: string,
    five-used-text: string,
    five-remaining-text: string,
    five-reset-text: string,
    five-remaining: float,
    five-visible: bool,
    seven-used-text: string,
    seven-remaining-text: string,
    seven-reset-text: string,
    seven-remaining: float,
    reset-count-text: string,
    credit-detail-text: string,
    credit-expiry-text: string,
    updated-text: string,
}

export component AppLogo inherits Image {
    source: @image-url("../assets/app-logo.png");
    image-fit: contain;
}

export component WindowSurface inherits Rectangle {
    background: #12171ff7;
    border-width: 1px;
    border-color: #65718073;
    border-radius: 18px;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 54px;
        border-radius: 17px;
        background: @linear-gradient(90deg, #ffffff12 0%, #7f91ae08 58%, #ffffff02 100%);
    }

    Rectangle {
        x: 20px;
        y: 1px;
        width: parent.width - 40px;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #dce8ff73 45%, #ffffff00 100%);
    }
}

export component TopSurface inherits Rectangle {
    in property <float> surface-opacity: 0.96;
    opacity: root.surface-opacity;
    background: #10151df8;
    border-width: 1px;
    border-color: #74808d85;
    border-radius: 17px;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 38px;
        border-radius: 16px;
        background: @linear-gradient(90deg, #ffffff13 0%, #8392ad09 48%, #ffffff03 100%);
    }

    Rectangle {
        x: 18px;
        y: 1px;
        width: parent.width - 36px;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #e6efff82 50%, #ffffff00 100%);
    }
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: #ffffff18;
}

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;

    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary ? #8a9fff91 : root.danger ? #ff7b8a66 : #ffffff29;
    background: touch.pressed
        ? (root.primary ? #637cff66 : root.danger ? #a43b493e : #ffffff22)
        : touch.has-hover
            ? (root.primary ? #637cff4c : root.danger ? #b2445230 : #ffffff17)
            : (root.primary ? #637cff35 : root.danger ? #9a394521 : #ffffff0d);

    Text {
        text: root.label;
        color: root.primary ? #edf0ff : root.danger ? #ffcbd1 : #e8edf3;
        font-family: "Segoe UI Variable Text";
        font-size: 11px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? #ffffff3d : #ffffff22;
    background: touch.pressed ? #ffffff21 : touch.has-hover ? #ffffff14 : transparent;

    Text {
        text: root.label;
        color: #dfe6ed;
        font-family: "Segoe UI Variable Text";
        font-size: 15px;
        font-weight: 450;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MeterBar inherits Rectangle {
    in property <float> value;
    in property <color> accent;

    height: 5px;
    border-radius: 3px;
    background: #ffffff15;

    Rectangle {
        width: max(5px, min(parent.width, parent.width * root.value / 100));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.accent;
    }
}

export component MiniMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent;

    background: transparent;

    Text {
        x: 0px;
        y: 1px;
        text: root.label;
        color: #83909e;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0px;
    }

    Text {
        x: 0px;
        y: 14px;
        width: parent.width;
        text: root.value;
        color: root.accent;
        font-family: "Segoe UI Variable Display";
        font-size: 14px;
        font-weight: 740;
        overflow: elide;
    }
}

export component GlassToggle inherits Rectangle {
    in-out property <bool> checked;

    width: 36px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.checked ? #91a3ff8f : #ffffff2b;
    background: root.checked ? #6278e651 : #ffffff0f;

    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? #e8ebff : #aab4bf;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in-out property <bool> checked;

    height: root.description == "" ? 34px : 44px;
    background: transparent;

    Text {
        x: 0px;
        y: root.description == "" ? 0px : 5px;
        width: parent.width - 50px;
        height: 20px;
        text: root.label;
        color: #dce3ea;
        font-family: "Segoe UI Variable Text";
        font-size: 11px;
        font-weight: 620;
        vertical-alignment: center;
    }

    if root.description != "": Text {
        x: 0px;
        y: 23px;
        width: parent.width - 50px;
        text: root.description;
        color: #788796;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        overflow: elide;
    }

    GlassToggle {
        x: parent.width - 36px;
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
    }
}

export component FieldLabel inherits Text {
    color: #7f8e9d;
    font-family: "Segoe UI Variable Text";
    font-size: 9px;
    font-weight: 700;
}

export component GlassSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;

    height: 28px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 12px;
        width: parent.width - 42px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff15;

        Rectangle {
            width: max(0px, min(parent.width, parent.width * (root.value - root.minimum) / (root.maximum - root.minimum)));
            height: parent.height;
            border-radius: parent.border-radius;
            background: #8799ff;
        }

        Rectangle {
            x: max(0px, min(parent.width - 12px, parent.width * (root.value - root.minimum) / (root.maximum - root.minimum) - 6px));
            y: -4px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 2px;
            border-color: #e7eaff;
            background: #7186f0;
        }
    }

    Text {
        x: parent.width - 34px;
        width: 34px;
        height: parent.height;
        text: round(root.value) + "%";
        color: #aebaff;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width - 42px;
        mouse-cursor: pointer;
        clicked => {
            root.value = max(root.minimum, min(root.maximum, root.minimum + touch.mouse-x / touch.width * (root.maximum - root.minimum)));
        }
        moved => {
            root.value = max(root.minimum, min(root.maximum, root.minimum + touch.mouse-x / touch.width * (root.maximum - root.minimum)));
        }
    }
}

export component MetricCell inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: #edf2f6;

    background: transparent;

    Text {
        x: 0px;
        y: 7px;
        text: root.label;
        color: #7e8d9b;
        font-family: "Segoe UI Variable Text";
        font-size: 9px;
        font-weight: 650;
    }

    Text {
        x: 0px;
        y: 24px;
        width: parent.width - 8px;
        text: root.value;
        color: root.value-color;
        font-family: "Segoe UI Variable Text";
        font-size: 12px;
        font-weight: 660;
        overflow: elide;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #ffffff12;
    }
}
