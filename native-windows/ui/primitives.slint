export struct CreditDisplay {
    title: string,
    status: string,
    expiry: string,
    available: bool,
}

export struct GaugeData {
    status-text: string,
    login-needed: bool,
    plan-text: string,
    source-text: string,
    five-used-text: string,
    five-remaining-text: string,
    five-reset-text: string,
    five-remaining: float,
    five-visible: bool,
    five-unlimited: bool,
    seven-used-text: string,
    seven-remaining-text: string,
    seven-reset-text: string,
    seven-remaining: float,
    reset-count-text: string,
    credit-total-text: string,
    credit-items: [CreditDisplay],
    updated-text: string,
}

export component MenuBarLogo inherits Image {
    source: @image-url("../assets/menu-bar-icon.svg");
    image-fit: contain;
}

export component WindowSurface inherits Rectangle {
    background: #151a21fa;
    border-width: 1px;
    border-color: #78849373;
    border-radius: 20px;

    Rectangle {
        x: 22px;
        y: 1px;
        width: parent.width - 44px;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #e2ebfa80 48%, #ffffff00 100%);
    }
}

export component TopSurface inherits Rectangle {
    in property <float> surface-opacity: 0.96;
    opacity: root.surface-opacity;
    background: #11161dfb;
    border-width: 1px;
    border-color: #ffffff2b;
    border-radius: 10px;
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: #ffffff19;
}

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;

    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary ? #75ddca8f : root.danger ? #ff89965e : #ffffff28;
    background: touch.pressed
        ? (root.primary ? #245e576f : root.danger ? #70343d66 : #ffffff20)
        : touch.has-hover
            ? (root.primary ? #245e5757 : root.danger ? #70343d4c : #ffffff16)
            : (root.primary ? #245e573e : root.danger ? #70343d36 : #ffffff0d);

    Text {
        text: root.label;
        color: root.primary ? #c9fff3 : root.danger ? #ffcbd1 : #edf1f5;
        font-family: "Microsoft YaHei UI";
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: 9px;
    border-width: 1px;
    border-color: touch.has-hover ? #ffffff43 : #ffffff25;
    background: touch.pressed ? #ffffff22 : touch.has-hover ? #ffffff15 : #ffffff08;

    Text {
        text: root.label;
        color: #e8edf2;
        font-family: "Segoe UI Symbol";
        font-size: 15px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MeterBar inherits Rectangle {
    in property <float> value;
    in property <color> accent;

    height: 5px;
    border-radius: 3px;
    background: #ffffff12;

    Rectangle {
        width: root.value <= 0 ? 0px : max(4px, min(parent.width, parent.width * root.value / 100));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.accent;
    }
}

export component GlassToggle inherits Rectangle {
    in-out property <bool> checked;
    callback changed(bool);

    width: 36px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.checked ? #78e2cd7f : #ffffff2b;
    background: root.checked ? #245e5769 : #ffffff10;

    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? #9bf4e2 : #aeb7c0;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }
}

export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in-out property <bool> checked;
    callback changed(bool);

    height: root.description == "" ? 36px : 46px;
    background: transparent;

    Text {
        x: 0px;
        y: root.description == "" ? 0px : 3px;
        width: parent.width - 48px;
        height: 22px;
        text: root.label;
        color: #e1e7ec;
        font-family: "Microsoft YaHei UI";
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }

    if root.description != "": Text {
        x: 0px;
        y: 25px;
        width: parent.width - 48px;
        text: root.description;
        color: #7f8d99;
        font-family: "Microsoft YaHei UI";
        font-size: 10px;
        overflow: elide;
    }

    GlassToggle {
        x: parent.width - 36px;
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        changed(value) => { root.changed(value); }
    }
}

export component FieldLabel inherits Text {
    color: #8997a4;
    font-family: "Microsoft YaHei UI";
    font-size: 10px;
    font-weight: 600;
}

export component SectionTitle inherits Text {
    color: #91a0ad;
    font-family: "Microsoft YaHei UI";
    font-size: 10px;
    font-weight: 700;
}

export component GlassSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);

    height: 28px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 12px;
        width: parent.width - 42px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff15;

        Rectangle {
            width: max(0px, min(parent.width, parent.width * (root.value - root.minimum) / (root.maximum - root.minimum)));
            height: parent.height;
            border-radius: parent.border-radius;
            background: #72dfca;
        }

        Rectangle {
            x: max(0px, min(parent.width - 12px, parent.width * (root.value - root.minimum) / (root.maximum - root.minimum) - 6px));
            y: -4px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 2px;
            border-color: #e4fff9;
            background: #54cdb6;
        }
    }

    Text {
        x: parent.width - 34px;
        width: 34px;
        height: parent.height;
        text: round(root.value) + "%";
        color: #9cebdc;
        font-family: "Segoe UI Variable Text";
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width - 42px;
        mouse-cursor: pointer;
        clicked => {
            root.value = max(root.minimum, min(root.maximum, root.minimum + touch.mouse-x / touch.width * (root.maximum - root.minimum)));
            root.changed(root.value);
        }
        moved => {
            if touch.pressed {
                root.value = max(root.minimum, min(root.maximum, root.minimum + touch.mouse-x / touch.width * (root.maximum - root.minimum)));
                root.changed(root.value);
            }
        }
    }
}
